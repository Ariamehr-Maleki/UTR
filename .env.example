# Enable only after migrations and live authentication/security checks pass.
UTR_LIVE_ENABLED=false
UTR_ACCOUNTS_ENABLED=false
UTR_SIGNUP_ENABLED=false
# Email delivery is independent of signup. Enable only after SMTP delivery is verified.
UTR_AUTH_EMAIL_ENABLED=false
# Previews must use a DIFFERENT Supabase project. Never set this to the production reference.
UTR_PREVIEW_PROJECT_REF=
# Server only; set securely in Vercel, never commit a value.
SUPABASE_SERVICE_ROLE_KEY=

# PDF upload fails closed unless a trusted private ClamAV service is reachable.
UTR_CLAMAV_HOST=
UTR_CLAMAV_PORT=3310
# Migration/bootstrap tools only; never expose to the browser.
DATABASE_URL=
BOOTSTRAP_USER_ID=
# Operator records how account ownership was independently checked; email auto-confirmation is insufficient.
BOOTSTRAP_IDENTITY_VERIFICATION=

# Read-only public content can be enabled independently of account/workflow activation.
UTR_PUBLIC_CONTENT_ENABLED=false
