  "narrative": {
    "northStar": "A public programme poster display",
    "overview": "An institutional research portal whose public identity comes from authentic event posters, scholarly covers and a clear Persian editorial hierarchy. White and pale blue frame real content; university blue anchors navigation and participation. Private workspaces remain denser, task-focused surfaces.\n\nThe original blue/cyan/white identity remains binding. The supplied university emblem remains prominent; the authentic wing artwork remains an available identity asset, not the redesigned homepage's main illustration. Vazirmatn is temporary: the exact reference font is unidentified. The rejected plain static group list is superseded by a controlled moving ribbon.",
    "keyCharacteristics": [
      "Persian-first RTL with isolated mixed-direction content.",
      "Real posters and journal covers with institutional provenance.",
      "White and blue editorial hierarchy with restrained depth around physical media.",
      "Distinct public exploration and private academic operation."
    ],
    "rules": [
      {
        "section": "colors",
        "name": "The Source Color Rule",
        "body": "Preserve original poster and cover colors; use the institutional palette for surrounding controls and layout."
      },
      {
        "section": "components",
        "name": "The Academic Boundary Rule",
        "body": "Historical editorial records are readable archives, never live attendance, registration, summary-submission or credit opportunities. Current events and private academic operations remain separate."
      }
    ],
    "dos": [
      "Do retain the authentic emblem and wing artwork and preserve the blue/cyan/white identity.",
      "Do show source posters and journal covers completely with their real colors and provenance.",
      "Do preserve keyboard focus, named controls, explicit status text and reduced-motion access.",
      "Do verify long Persian text, mixed-direction content and layouts at 390, 768 and 1440 pixels.",
      "Do distinguish historical editorial content from current academic records and keep empty states honest."
    ],
    "donts": [
      "Don't claim the temporary Vazirmatn font matches the reference.",
      "Don't use decorative cyan for primary text or action labels.",
      "Don't invent activity counts, endorsements, achievements or testimonials.",
      "Don't infer permissions from visual role switching or historical archive membership.",
      "Don't treat screenshot checks or this document as production-readiness approval."
    ]
  }
